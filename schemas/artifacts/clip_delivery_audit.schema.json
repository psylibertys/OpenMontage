{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/clip_delivery_audit",
  "title": "Clip Delivery Audit",
  "description": "Hard post-render gate for exact frame-zero cover evidence and final-MP4 audio/subtitle synchronization.",
  "type": "object",
  "required": ["version", "status", "acceptance", "outputs", "failed_clip_ids"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "status": { "type": "string", "enum": ["pass", "fail"] },
    "acceptance": {
      "type": "object",
      "required": ["minimum_matched_ratio", "maximum_p90_error_seconds", "frame_zero_requires_expected_hook", "standalone_cover_required"],
      "properties": {
        "minimum_matched_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximum_p90_error_seconds": { "type": "number", "minimum": 0 },
        "frame_zero_requires_expected_hook": { "const": true },
        "standalone_cover_required": { "const": true }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["clip_id", "video_path", "cover_path", "technical", "frame_zero", "subtitle_sync", "status", "issues"],
        "properties": {
          "clip_id": { "type": "string" },
          "video_path": { "type": "string" },
          "cover_path": { "type": "string" },
          "technical": { "type": "object" },
          "frame_zero": {
            "type": "object",
            "required": ["sample_path", "expected_hook_title", "title_visible", "review_method"],
            "properties": {
              "sample_path": { "type": "string" },
              "expected_hook_title": { "type": "string", "minLength": 1 },
              "title_visible": { "type": "boolean" },
              "review_method": { "const": "human_visual_exact_frame_n0" }
            },
            "additionalProperties": false
          },
          "subtitle_sync": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "enum": ["pass", "fail"] },
              "expected_words": { "type": "integer" },
              "actual_words": { "type": "integer" },
              "matched_words": { "type": "integer" },
              "matched_ratio": { "type": "number" },
              "median_signed_delta_seconds": { "type": ["number", "null"] },
              "median_absolute_error_seconds": { "type": ["number", "null"] },
              "p90_absolute_error_seconds": { "type": ["number", "null"] },
              "max_absolute_error_seconds": { "type": ["number", "null"] }
            },
            "additionalProperties": false
          },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "issues": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "failed_clip_ids": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
